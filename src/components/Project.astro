---
interface Props {
  title: string;
  img: string;
  code: string;
  live?: string;
  desc: string;
  tech: string;
}

const { title, img, code, live, desc, tech } = Astro.props;
---

<article class="project">
  <h2 class="project-title"><span data-project-title>{title}</span></h2>
  <div class="project-content">
    <wired-card class="video-card" elevation="3">
      <video muted playsinline loop autoplay preload="metadata" aria-label={`${title} demo`}>
        <source src={img} />
      </video>
    </wired-card>
    <div class="project-description">
      <p>{desc}</p>
      <small data-project-tech>{tech}</small>
      <div class="project-links">
        {live && (
          <a href={live} aria-label={`View ${title} live`}>
            <wired-fab inert aria-hidden="true"><i class="ri-link"></i></wired-fab>
          </a>
        )}
        <a href={code} aria-label={`View ${title} source code`}>
          <wired-fab inert aria-hidden="true"><i class="ri-github-line"></i></wired-fab>
        </a>
      </div>
    </div>
  </div>
</article>

<script>
  import "wired-card";
  import "wired-fab";
</script>
