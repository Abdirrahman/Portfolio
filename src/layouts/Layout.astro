---
import "../styles/globals.css";

interface Props {
  title?: string;
  preview?: boolean;
}

const { title = "Abdirrahman Mohamed | R&D Tax Consultant", preview = false } = Astro.props;
const description = "Abdirrahman Mohamed, R&D tax consultant with software and data engineering experience. Previously at Bonham & Brook and Sigma Labs.";
const canonical = new URL("/", Astro.site).href;
const profile = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: canonical,
  name: title,
  mainEntity: {
    "@type": "Person",
    "@id": `${canonical}#abdirrahman`,
    name: "Abdirrahman Mohamed",
    alternateName: "Abdirrahman",
    url: canonical,
    description,
    sameAs: ["https://github.com/Abdirrahman", "https://www.linkedin.com/in/abdirrahman/"],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />
    {!preview && <>
      <link rel="canonical" href={canonical} />
      <meta property="og:type" content="profile" />
      <meta property="og:site_name" content="Abdirrahman" />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:url" content={canonical} />
      <meta name="twitter:card" content="summary" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <script type="application/ld+json" set:html={JSON.stringify(profile).replace(/</g, "\\u003c")} />
    </>}
    <meta name="theme-color" content="#161616" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/inter-latin-variable-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-latin-variable-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav class="contact-links" aria-label="Contact">
      <a href="https://github.com/Abdirrahman" aria-label="GitHub" title="GitHub">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7M9 22v-3.1c0-1 .1-1.6.6-2.2-3.1-.3-6.3-1.5-6.3-6.6 0-1.5.5-2.7 1.4-3.7-.2-.4-.6-1.9.1-3.8 0 0 1.2-.4 3.9 1.4a13.2 13.2 0 0 1 6.6 0c2.7-1.8 3.9-1.4 3.9-1.4.7 1.9.3 3.4.1 3.8.9 1 1.4 2.2 1.4 3.7 0 5.1-3.2 6.3-6.3 6.6.5.5.6 1.3.6 2.2V22" />
        </svg>
      </a>
      <a href="https://www.linkedin.com/in/abdirrahman/" aria-label="LinkedIn" title="LinkedIn">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" />
          <circle cx="7.5" cy="8" r="0.75" />
          <path d="M7.5 11.5v5M11.5 16.5v-5m0 2.1c0-2.8 5-2.8 5 0v2.9" />
        </svg>
      </a>
      <a href="mailto:abdirrahman@outlook.com" aria-label="Email" title="Email">
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m4 6 8 6 8-6" />
        </svg>
      </a>
    </nav>
    <main id="main" class="page">
      <slot />
    </main>
  </body>
</html>
