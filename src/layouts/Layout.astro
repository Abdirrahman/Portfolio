---
import Nav from "../components/Nav.astro";
import "../styles/globals.css";
import "remixicon/fonts/remixicon.css";

interface Props {
  title?: string;
}

const { title = "Abdirrahman Mohamed | Data & Software Engineer" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Abdirrahman Mohamed, a Data & Software Engineer based in London. Explore my software and data projects."
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <Nav />
      <main id="main">
        <slot />
      </main>
    </div>
  </body>
</html>
