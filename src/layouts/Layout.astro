---
import "../styles/globals.css";

interface Props {
  title?: string;
}

const { title = "Abdirrahman Mohamed | Software & R&D tax" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Software roots, R&D tax expertise; now helping companies claim what their innovation’s worth. Selected projects by Abdirrahman Mohamed."
    />
    <meta name="theme-color" content="#fcfcfd" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main" class="page">
      <slot />
    </main>
  </body>
</html>
