{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "bunx bun@1.3.14 install --frozen-lockfile",
  "buildCommand": "bunx bun@1.3.14 run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/videos/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
